<?xml version="1.0" ?>
<!--
  REAL-TIME variant of rl_corrector.world, for measure-the-response tools.

  Identical in every respect (same ground friction, same gravity, same absent
  building/patches) EXCEPT real_time_update_rate, which is 100 here instead of
  0. That is the whole point of the file.

  WHY IT EXISTS. rl_corrector.world runs uncapped (~33x realtime on the VM),
  which puts /imu/data at ~3300 Hz. Any node that subscribes with a normal
  queue depth and a single-threaded executor then drops the overwhelming
  majority of samples: slip_ident integrated the gyro to ~1/800 of the true
  yaw and correctly refused to report a chi. Training does not care -- it
  consumes ground-truth pose through the bridge, on its own stepped clock --
  but anything that DRIVES the robot and MEASURES the response needs the
  sensors to arrive at a rate a subscriber can keep up with.

  WHY NOT set_physics AT RUNTIME. The service overwrites every field of the
  Physics component from the request, and the gz Physics proto defaults
  gravity to (0,0,0) -- so throttling at runtime silently zeroes gravity and
  the robot floats. That is the same trap rl_corrector.world's header warns
  about in the opposite direction. A second world file costs nothing and
  cannot misfire.

  Select it with:  ros2 launch agx_bringup rl_corrector_sim.launch.py \
                       world:=rl_corrector_rt.world

  KEEP THE GROUND FRICTION IN SYNC with rl_corrector.world -- a chi measured
  against a different surface than the one training runs on is worse than no
  measurement at all.
-->
<sdf version="1.9">
  <world name="rl_corrector">
    <!-- Required for magnetometer to compute local magnetic field -->
    <spherical_coordinates>
      <!-- Standard Earth ellipsoid model -->
      <surface_model>EARTH_WGS84</surface_model>
      <!-- Location about in the middle of RUDN Ordjonikidze building -->
      <latitude_deg>55.71045</latitude_deg>
      <longitude_deg>37.60338</longitude_deg>
      <elevation>147.67</elevation>
      <heading_deg>0.0</heading_deg>
    </spherical_coordinates>

    <!-- Pinned explicitly (gz default is the same) so set_physics restoring or
         re-setting physics has a known-correct value to write back. -->
    <gravity>0 0 -9.8</gravity>

    <physics name="default_physics" type="ode">
      <max_step_size>0.01</max_step_size>
      <!-- 100 Hz * 0.01 s step = 1.0x realtime. This is the ONLY difference
           from rl_corrector.world (see header): sensors must arrive slowly
           enough for a subscriber to keep up. -->
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
            </plane>
          </geometry>
          <!-- Kept equal to rl_corrector.world -- see its much longer note on
               why this must stay above the wheel's mu2 of 0.7. Changing one
               without the other makes a chi measured here describe a different
               surface than training runs on, which is worse than not measuring.
               tools/sweep_ground_mu.sh rewrites this line while sweeping and
               leaves it at the last value; reset it deliberately afterwards. -->
          <surface>
            <friction>
              <ode>
                <mu>1.0</mu>
                <mu2>1.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>300 150</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
