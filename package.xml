<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rudn_ordjo_building</name>
  <version>0.0.1</version>
  <description>TODO: Package description</description>
  <maintainer email="gmatiukhin@todo.todo">gmatiukhin</maintainer>
  <license>MIT</license>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_media_path="${prefix}/models/meshes"/>
  </export>
  <depend>ros_gz_sim</depend>
  <exec_depend>ament_index_python</exec_depend>

  <!-- map_publisher: serves the baked occupancy grids under maps/ -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-pil</exec_depend>
</package>
